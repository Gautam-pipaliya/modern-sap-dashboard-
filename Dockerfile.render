FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=10000 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    COPILOT_HOST=127.0.0.1 \
    COPILOT_PORT=8000 \
    COPILOT_MEMORY_DB=/tmp/copilot_memory.sqlite3

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates gosu passwd python3 python3-venv tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 chatbot \
    && python3 -m venv /opt/chatbot-venv

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY requirements.txt ./
RUN /opt/chatbot-venv/bin/pip install --no-cache-dir -r requirements.txt

COPY backend ./backend
COPY frontend ./frontend
COPY app.py ./app.py
COPY scripts/start-render.sh ./scripts/start-render.sh
RUN chmod 0555 /app/scripts/start-render.sh && bash -n /app/scripts/start-render.sh

EXPOSE 10000

CMD ["tini", "-g", "--", "/app/scripts/start-render.sh"]
