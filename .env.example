NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Local, read-only client presentation mode. Start with `npm run demo`.
# All displayed SAP records in this mode are fictional sample data.
DEMO_MODE=false

# Required SAP connection settings. SAP_BASE_URL must use HTTPS.
SAP_BASE_URL=https://sap.example.com
SAP_CLIENT=100
SAP_USERNAME=your_sap_user
SAP_PASSWORD=your_sap_password

# Optional defaults for the Sales Order create/search page. Set values valid
# for this SAP system; leave blank when you prefer to enter them in the page.
SAP_SALES_ORDER_TYPE=OR
SAP_SALES_ORGANIZATION=
SAP_DISTRIBUTION_CHANNEL=
SAP_DIVISION=
SAP_SOLD_TO_PARTY=
SAP_DEFAULT_MATERIAL=
SAP_DEFAULT_UNIT=EA
SAP_DEFAULT_PLANT=
SAP_DEFAULT_STORAGE_LOCATION=

# Required when HOST is not localhost. Use a unique, strong password.
DASHBOARD_USERNAME=your-dashboard-user
DASHBOARD_PASSWORD=replace_with_a_long_random_password

# Keep TLS verification enabled. Node also trusts the operating system CA store.
SAP_TLS_REJECT_UNAUTHORIZED=true
# Optional PEM file for your SAP root/intermediate CA. Relative paths resolve from the project directory.
# SAP_CA_CERT=C:/certs/sap-root-ca.pem
# Optional TLS certificate name when SAP_BASE_URL uses an IP or alias not present in the certificate.
# SAP_TLS_SERVERNAME=sap.example.com
# When using docker-compose.ca.yml, set this host-side path to the PEM file above.
# SAP_CA_CERT_HOST_PATH=C:/certs/sap-root-ca.pem
# Optional explicit proxy for SAP API calls. Ambient HTTP_PROXY values are ignored;
# SAP GUI for HTML uses a direct connection.
# SAP_HTTP_PROXY=http://proxy.example.com:8080

# Gemini chatbot settings. Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Set false to bypass inherited HTTP_PROXY/HTTPS_PROXY settings; set true when your network requires a proxy.
GEMINI_TRUST_ENV=true
GEMINI_TIMEOUT_SECONDS=60

# Standalone chatbot binds locally; Compose overrides these for its private network.
COPILOT_HOST=127.0.0.1
COPILOT_PORT=8000

